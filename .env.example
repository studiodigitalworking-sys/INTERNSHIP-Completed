# Copy to .env. Development values only — never commit real secrets.
DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"
APP_SECRET="change-me-to-a-random-32+-byte-secret"
# DEMO_MODE=false hides demo accounts on the login page
# Razorpay (test or live) — when unset, the SANDBOX adapter is used
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# CRON_SECRET=           # protects /api/cron/outbox
# EMAIL_PROVIDER=        # unset = log transport only (no real delivery)
