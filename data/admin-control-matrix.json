 "Exception Types": [
  {
   "Exception Code": "DATA_ENTRY_CORRECTION",
   "Purpose": "Correct wrong profile/source data",
   "Required Reason": "Yes",
   "Evidence Recommended": "Original document or verified request",
   "Audit Requirement": "Before/after + actor + timestamp"
  },
  {
   "Exception Code": "SERVER_OR_SYNC_FAILURE",
   "Purpose": "Repair failed import/sync/system error",
   "Required Reason": "Yes",
   "Evidence Recommended": "Logs, event ID, import file",
   "Audit Requirement": "Before/after + incident reference"
  },
  {
   "Exception Code": "ATTENDANCE_EVIDENCE_CORRECTION",
   "Purpose": "Correct mistaken attendance",
   "Required Reason": "Yes",
   "Evidence Recommended": "Host sheet, session logs, supervisor confirmation",
   "Audit Requirement": "Original event retained"
  },
  {
   "Exception Code": "ELIGIBILITY_EXCEPTION",
   "Purpose": "Resolve documented eligibility edge case",
   "Required Reason": "Yes",
   "Evidence Recommended": "Rule result and authority",
   "Audit Requirement": "Exception remains visible"
  },
  {
   "Exception Code": "ASSESSMENT_REEVALUATION",
   "Purpose": "Review disputed assessment",
   "Required Reason": "Yes",
   "Evidence Recommended": "Submission, rubric, reviewer notes",
   "Audit Requirement": "Old and new result retained"
  },
  {
   "Exception Code": "MARKS_ADJUSTMENT",
   "Purpose": "Adjust marks after review",
   "Required Reason": "Yes",
   "Evidence Recommended": "Rubric and approval",
   "Audit Requirement": "Old/new marks + approver"
  },
  {
   "Exception Code": "APPROVED_WAIVER",
   "Purpose": "Waive a requirement under an authorised rule",
   "Required Reason": "Yes",
   "Evidence Recommended": "Policy and approval",
   "Audit Requirement": "Waiver scope and expiry"
  },
  {
   "Exception Code": "CERTIFICATE_MANUAL_ISSUANCE",
   "Purpose": "Manual certificate after genuine requirements verified",
   "Required Reason": "Yes",
   "Evidence Recommended": "Evidence and issuer authority",
   "Audit Requirement": "Credential event and audit"
  },
  {
   "Exception Code": "CERTIFICATE_REISSUE",
   "Purpose": "Correct spelling/details or reissue file",
   "Required Reason": "Yes",
   "Evidence Recommended": "Old credential and correction evidence",
   "Audit Requirement": "Link old/new credential"
  },
  {
   "Exception Code": "CREDENTIAL_REVOCATION",
   "Purpose": "Revoke invalid/withdrawn credential",
   "Required Reason": "Yes",
   "Evidence Recommended": "Reason and evidence",
   "Audit Requirement": "Permanent status history"
  },
  {
